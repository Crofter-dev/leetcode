class Solution:
    def spiralOrder(self, matrix: list[list[int]]) -> list[int]:
        m, n = len(matrix), len(matrix[0])
        result = []
        r, c = 0, 0
        dr, dc = 0, 1  

        for _ in range(m * n):
            result.append(matrix[r][c])
            matrix[r][c] = None  

            nr, nc = r + dr, c + dc

            if not (0 <= nr < m and 0 <= nc < n and matrix[nr][nc] is not None):
                dr, dc = dc, -dr  
                nr, nc = r + dr, c + dc

            r, c = nr, nc

        return result

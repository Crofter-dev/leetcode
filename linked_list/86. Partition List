class Solution:
    def partition(self, head: Optional[ListNode], x: int) -> Optional[ListNode]:
        if not head:
            return None

        vals = []
        curr = head
        while curr:
            vals.append(curr.val)
            curr = curr.next

        less = [v for v in vals if v < x]
        greater_or_equal = [v for v in vals if v >= x]
        partitioned = less + greater_or_equal

        curr = head
        for val in partitioned:
            curr.val = val
            curr = curr.next

        return head

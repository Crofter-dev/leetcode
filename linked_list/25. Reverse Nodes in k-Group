class Solution:
    def reverseKGroup(self, head: Optional[ListNode], k: int) -> Optional[ListNode]:
        vals = []
        curr = head
        while curr:
            vals.append(curr.val)
            curr = curr.next
            
        for i in range(0, len(vals), k):
            if i + k <= len(vals):
                vals[i : i + k] = reversed(vals[i : i + k])
                
        dummy = ListNode(0)
        curr = dummy
        for val in vals:
            curr.next = ListNode(val)
            curr = curr.next
            
        return dummy.next

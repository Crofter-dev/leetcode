from functools import cache

class Solution:
    def minDistance(self, word1: str, word2: str) -> int:
        @cache
        def solve(i: int, j: int) -> int:
            if i == 0: return j  
            if j == 0: return i  
            
            if word1[i - 1] == word2[j - 1]:
                return solve(i - 1, j - 1)
            
            return 1 + min(
                solve(i, j - 1),      
                solve(i - 1, j),      
                solve(i - 1, j - 1)   
            )

        return solve(len(word1), len(word2))
